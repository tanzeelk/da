# =========================================================
# DA Group — Apache redirect & canonicalization rules
# Fixes audit Issues #1, #9, #14 (critical)
# =========================================================

RewriteEngine On

# -----------------------------------------------------------
# 1) Force non-www + HTTPS (Issue #14: www vs non-www duplicate)
#    www.dagroupindia.com  -> https://dagroupindia.com
#    http://dagroupindia.com -> https://dagroupindia.com
# -----------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.dagroupindia\.com$ [NC]
RewriteRule ^(.*)$ https://dagroupindia.com/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://dagroupindia.com/$1 [L,R=301]

# -----------------------------------------------------------
# 2) Collapse /index.html -> / (Issue #1: duplicate homepage URL)
# -----------------------------------------------------------
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# -----------------------------------------------------------
# 3) Legacy pre-relaunch URLs -> current pages (Issue #9)
#    Old site used trailing-slash "pretty" URLs; new site uses .html
# -----------------------------------------------------------
RewriteRule ^gallery/?$            /gallery.html            [L,R=301]
RewriteRule ^career/?$             /career.html              [L,R=301]
RewriteRule ^group-companies/?$    /group-companies.html      [L,R=301]
RewriteRule ^contact-us/?$         /contact.html              [L,R=301]
RewriteRule ^about-us/?$           /about.html                [L,R=301]
RewriteRule ^industry-updates/?$   /industry-updates.html     [L,R=301]
RewriteRule ^da-updates/?$         /da-updates.html           [L,R=301]

# CSR and Youth Intellectual Platform — no direct successor page yet.
# Routed to About Us until dedicated pages exist; update targets once available.
RewriteRule ^csr/?$                        /about.html [L,R=301]
RewriteRule ^youth-intellectual-platform/?$ /about.html [L,R=301]

# Old individual news/article URLs — no 1:1 successor articles exist on the
# new site, so send to the DA Updates hub instead of a dead end.
RewriteRule ^iits-to-help-textiles-get-back-on-track/?$                                  /da-updates.html [L,R=301]
RewriteRule ^india-to-organize-worlds-largest-virtual-fair-for-textiles/?$               /da-updates.html [L,R=301]
RewriteRule ^affordable-rental-housing-complexes-included-in-list-of-infrastructure-sub-sectors/?$ /da-updates.html [L,R=301]

# -----------------------------------------------------------
# 4) Custom 404 (optional — uncomment once a 404.html page exists)
# -----------------------------------------------------------
# ErrorDocument 404 /404.html
